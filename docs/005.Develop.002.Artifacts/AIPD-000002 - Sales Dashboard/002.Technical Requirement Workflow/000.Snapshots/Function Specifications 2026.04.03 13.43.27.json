        "Bookings Collection Schema": {
          "Collection Name": "sales_bookings_delta",
          "Fields": {
            "_id": "ObjectId",
            "crm_reference_id": "String (Unique)",
            "owner_id": "UUID (Mapped to Postgres User.id limits)",
            "amount_cents": "NumberLong (To avoid Float precision loss)",
            "booked_at": "ISODate"
          },
          "Index Constraint": "Compound index on { owner_id: 1, booked_at: -1 }"
        },
        "FR-011 & AFI-000004 (Density & Timezone Matcher)": {
          "$group Pipeline Logic": "{ _id: { $dateTrunc: { date: '$booked_at', unit: '<MONTH|DAY>', timezone: '<Client Timezone>' } }, totalAmount: { $sum: '$amount_cents' } }"
        }
      }
