{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Test Steps Schema",
    "type": "object",
    "description": "Structure for storing test execution steps, grouped by Test Specification (TES) and Test Case (CAS)",
    "required": ["requestVersion", "version", "parentVersion"],
    "properties": {
        "requestVersion": {
            "type": "string",
            "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2} \\d{2}\\.\\d{2}\\.\\d{2}$",
            "description": "Version of the request (e.g., 2026.04.02 11.30.00)"
        },
        "version": {
            "type": "string",
            "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2} \\d{2}\\.\\d{2}\\.\\d{2}$",
            "description": "Version of the current document (e.g., 2026.04.02 11.30.00)"
        },
        "parentVersion": {
            "type": "string",
            "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2} \\d{2}\\.\\d{2}\\.\\d{2}$",
            "description": "Version of the parent document used as source (e.g., 2026.04.02 11.30.00)"
        }
    },
    "additionalProperties": {
        "type": "object",
        "patternProperties": {
            "^CAS-\\d{6}$": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "id",
                        "stepNumber",
                        "description",
                        "expectedResults"
                    ],
                    "properties": {
                        "id": {
                            "type": "string",
                            "format": "uuid",
                            "description": "Unique ID of the execution step"
                        },
                        "stepNumber": {
                            "type": "string",
                            "pattern": "^STE-\\d{6}$",
                            "description": "Step number code (e.g., STE-000001)"
                        },
                        "description": {
                            "type": "string",
                            "description": "Description of the step action"
                        },
                        "expectedResults": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": [
                                    "id",
                                    "description"
                                ],
                                "properties": {
                                    "id": {
                                        "type": "integer",
                                        "description": "Sequence number of the expected result"
                                    },
                                    "description": {
                                        "type": "string",
                                        "description": "Description of the expected result"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "propertyNames": {
        "pattern": "^TES-\\d{6}$"
    }
}