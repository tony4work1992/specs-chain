{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "description": "List of data structure sections",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "Section identifier (e.g., SEC-001)"
      },
      "title": {
        "type": "string",
        "description": "Section title (e.g., UI States, UI Fields, ...)"
      },
      "theme": {
        "type": "string",
        "description": "Main color or theme of the section (e.g., emerald)"
      },
      "requestVersion": {
        "type": "string",
        "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2} \\d{2}\\.\\d{2}\\.\\d{2}$",
        "description": "Version of the request (e.g., 2026.04.02 11.30.00)"
      },
      "version": {
        "type": "string",
        "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2} \\d{2}\\.\\d{2}\\.\\d{2}$",
        "description": "Version of the current document (e.g., 2026.04.02 11.30.00)"
      },
      "parentVersion": {
        "type": "string",
        "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2} \\d{2}\\.\\d{2}\\.\\d{2}$",
        "description": "Version of the parent document used as source (e.g., 2026.04.02 11.30.00)"
      },
      "items": {
        "type": "array",
        "description": "List of data records corresponding to the title",
        "items": {
          "type": "object",
          "description": "Each item is a flexible key-value pair depending on the nature of the section",
          "additionalProperties": {
            "type": ["string", "boolean", "number", "null"]
          }
        }
      }
    },
    "required": [
      "id",
      "title",
      "theme",
      "items",
      "requestVersion",
      "version",
      "parentVersion"
    ],
    "additionalProperties": false
  }
}