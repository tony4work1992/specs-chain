{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "description": "List of UI Component Architectural Tiers",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "Tier identifier (e.g., TIER-001)"
      },
      "title": {
        "type": "string",
        "description": "Atomic Tier (e.g., Atoms, Molecules, Organisms, Templates, Pages)"
      },
      "requestVersion": {
        "type": "string",
        "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2} \\d{2}\\.\\d{2}\\.\\d{2}$",
        "description": "Version of the request"
      },
      "version": {
        "type": "string",
        "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2} \\d{2}\\.\\d{2}\\.\\d{2}$",
        "description": "Version of the current document"
      },
      "parentVersion": {
        "type": "string",
        "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2} \\d{2}\\.\\d{2}\\.\\d{2}$",
        "description": "Version of the parent document"
      },
      "items": {
        "type": "array",
        "description": "List of React Components mapped to this tier",
        "items": {
          "type": "object",
          "description": "Component specifications mapping state, props, and smart/dumb classification",
          "additionalProperties": {
            "type": ["string", "boolean", "number", "null"]
          }
        }
      }
    },
    "required": [
      "id",
      "title",
      "items",
      "version",
      "parentVersion"
    ],
    "additionalProperties": false
  }
}
